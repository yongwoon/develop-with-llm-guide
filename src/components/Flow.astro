---
// A flow on a flow page: numbered <FlowStep>s joined by a connector line.
// Fails the build when the step count differs from titleBlock.steps or when
// loop steps do not come in ↔ pairs (spec 03-data cross-checks).
const { entry } = Astro.locals.starlightRoute;
const { data } = entry;
if (data.kind !== 'flow') {
	throw new Error(`Flow: ${entry.id} is kind "${data.kind}", not a flow page`);
}

const html = await Astro.slots.render('default');
const kinds = [...html.matchAll(/data-flow-step="(step|loop|alt)"/g)].map((match) => match[1]);
if (kinds.length !== data.titleBlock.steps) {
	throw new Error(
		`Flow: ${entry.id} has ${kinds.length} FlowStep(s) but titleBlock.steps is ${data.titleBlock.steps}`,
	);
}
const loopRuns = kinds.join(' ').match(/(?:loop ?)+/g) ?? [];
if (loopRuns.some((run) => run.trim().split(' ').length !== 2)) {
	throw new Error(`Flow: ${entry.id} has kind="loop" steps that are not consecutive pairs`);
}
---

<ol class="flow not-content" set:html={html} />

<style>
	.flow {
		position: relative;
		margin: 1.5rem 0;
		padding: 0;
		counter-reset: flow-step;
	}
</style>
