---
// A flow on a flow page: numbered <FlowStep>s joined by a connector line.
// Fails the build when the step or optional-step count differs from
// titleBlock, or when loop steps do not come in ↔ pairs (spec 03-data). The
// counts are read from the markers FlowStep puts on each rendered <li>.
const { entry } = Astro.locals.starlightRoute;
const { data } = entry;
if (data.kind !== 'flow') {
	throw new Error(`Flow: ${entry.id} is kind "${data.kind}", not a flow page`);
}

const html = await Astro.slots.render('default');
const kinds = [...html.matchAll(/data-flow-step="(step|loop|alt)"/g)].map((match) => match[1]);
if (kinds.length !== data.titleBlock.steps) {
	throw new Error(
		`Flow: ${entry.id} has ${kinds.length} FlowStep(s) but titleBlock.steps is ${data.titleBlock.steps}`,
	);
}
const optionalCount = [...html.matchAll(/data-flow-optional="true"/g)].length;
if (optionalCount !== data.titleBlock.optional) {
	throw new Error(
		`Flow: ${entry.id} has ${optionalCount} optional FlowStep(s) but titleBlock.optional is ${data.titleBlock.optional}`,
	);
}
// Each ↔ is two consecutive loop steps, so every run of loops has even length.
const loopRuns = kinds.join(' ').match(/(?:loop ?)+/g) ?? [];
if (loopRuns.some((run) => run.trim().split(' ').length % 2 !== 0)) {
	throw new Error(`Flow: ${entry.id} has kind="loop" steps that are not consecutive pairs`);
}
---

<ol class="flow not-content" role="list" set:html={html} />

<style>
	.flow {
		position: relative;
		margin: 1.5rem 0;
		padding: 0;
		counter-reset: flow-step;
	}
</style>
